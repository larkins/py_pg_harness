# =============================================================================
# Harness configuration -- copy to .env and fill in the blanks.
#
# Every variable below is documented. The ones with an empty value (or a
# REPLACE_ME placeholder) MUST be set before the app starts: config.yaml
# resolves ${VAR} references against this file and fails loudly when one
# is missing.
# =============================================================================

# --- Flask ------------------------------------------------------------------
# Secret key for the session cookie. Generate one, e.g.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
HARNESS_SECRET_KEY=
# Address the app listens on (host:port).
HARNESS_BIND=0.0.0.0:5010
# TLS certificate + key for the HTTPS listener (paths on this host).
HARNESS_TLS_CERT=/etc/harness/tls/cert.pem
HARNESS_TLS_KEY=/etc/harness/tls/key.pem
# Flask mode + unbuffered output (container-friendly logs).
FLASK_ENV=production
PYTHONUNBUFFERED=1

# --- Postgres ----------------------------------------------------------------
# The database the app connects as (the runtime role).
DATABASE_URL=postgresql://harness_app:REPLACE_ME@localhost:5432/harness
# The role that owns the schemas and the tables (the operator role). It
# creates the agent schemas and runs the migrations.
APP_DB_OPERATOR_ROLE=harness_operator
# The role the app itself connects as. It gets DML on the agent schemas
# and SELECT on public.users -- nothing else.
APP_DB_RUNTIME_ROLE=harness_app
# Name of the database that holds the agent schemas. When the agent
# schemas live in a different database than the app's own tables, set
# HARNESS_INSTALLATION_DATABASE to that database and leave HARNESS_DB as
# the app's database.
HARNESS_DB=harness
HARNESS_INSTALLATION_DATABASE=harness

# --- Agents ------------------------------------------------------------------
# The default agent (used when the roster in config.yaml is empty).
HARNESS_DEFAULT_AGENT=agent
# Optional override for the installed agent roster (comma-separated).
# When empty, tools/migrate.sh uses the `app.agents` list from
# config.yaml. Keep the two in sync: every agent in the roster gets its
# own schema in the database.
HARNESS_AGENTS=
# Root directory of the per-agent "pie" directories (relative to the
# install directory unless absolute).
HARNESS_PIE_ROOT=pie

# --- LLM (per-installation; adapter module + key) ----------------------------
# Which adapter to use. See app/agent/llm/ for the available adapters.
LLM_ADAPTER=minimax_m3
# API key for the LLM provider.
LLM_API_KEY=
# Base URL of the LLM provider.
LLM_BASE_URL=https://api.minimax.io/anthropic
# Model name.
LLM_MODEL=MiniMax-M3
# Max tokens per reply.
LLM_MAX_TOKENS=2048
# Request timeout, seconds.
LLM_TIMEOUT_S=60
# Sampling temperature.
LLM_TEMPERATURE=0.7


# --- Embeddings (shared GPU server) -------------------------------------------
# Base URL of the OpenAI-compatible embeddings endpoint.
EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
# Embedding model name.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
# Embedding dimensions (must match the vector column: halfvec(1024)).
EMBEDDING_DIMENSIONS=1024
# API key for the embeddings endpoint (if it needs one).
EMBEDDING_API_KEY=
# Request timeout, seconds.
EMBEDDING_TIMEOUT_S=10

# --- Memory tuning -----------------------------------------------------------
# How many memories the recall returns.
MEMORY_TOP_K=10
# Cap on the vector-search candidates.
MEMORY_VECTOR_LIMIT=30
# Cap on the trigram-search candidates.
MEMORY_TRIGRAM_LIMIT=30
# How many days back the recency search looks.
MEMORY_RECENCY_DECAY_DAYS=30
# Chunking of long content: maximum tokens per chunk.
MEMORY_CHUNK_MAX_TOKENS=800
# Chunking of long content: minimum tokens per chunk.
MEMORY_CHUNK_MIN_TOKENS=20
# Chunking of long content: token overlap between chunks.
MEMORY_CHUNK_OVERLAP_TOKENS=50

# --- Permanent memory (injected every prompt) ---------------------------------
# Token budget for the permanent-memory block injected into every prompt.
MEMORY_PERMANENT_MAX_TOKENS=10000
# Warn when the permanent-memory block is close to its budget.
MEMORY_PERMANENT_WARN_OVERFLOW=true
# Audit pinning operations.
MEMORY_PERMANENT_PIN_AUDIT=true

# --- Workspace bootstrap files (per-file caps; hard fail on overflow) ---------
# Cap for SOUL.md.
BOOTSTRAP_SOUL_MAX_BYTES=8000
# Cap for USER.md.
BOOTSTRAP_USER_MAX_BYTES=4000
# Cap for AGENTS.md.
BOOTSTRAP_AGENTS_MAX_BYTES=24000
# Cap for IDENTITY.md.
BOOTSTRAP_IDENTITY_MAX_BYTES=8000
# Cap for MEMORY.md.
BOOTSTRAP_MEMORY_MAX_BYTES=65536
# What to do when a file exceeds its cap: fail | truncate.
BOOTSTRAP_OVERFLOW=fail

# --- Conditional system-prompt pressure warnings ------------------------------
# When an identity file or the permanent-memory block passes this fraction
# of its cap, the agent is told to move the detail out of it.
PROMPT_PRESSURE_ENABLED=true
# The fraction of the cap that triggers the warning.
PROMPT_PRESSURE_THRESHOLD=0.85

# --- Nightly reverie ----------------------------------------------------------
# A real agent turn (captured in the turns table) that asks the agent to
# clean up its own context budget down to the target percentages, then
# reflect and put proposals to the user in chat. It only fires if the
# agent had activity in the window.
REVERIE_ENABLED=false
# Empty = every installed agent. Otherwise a comma-separated list.
REVERIE_AGENTS=
# Nightly time of day (local to REVERIE_TIMEZONE).
REVERIE_AT=03:00
# Timezone the nightly time is interpreted in.
REVERIE_TIMEZONE=Australia/Brisbane
# Target as a fraction of each cap (0.60 leaves headroom below the
# 0.85 prompt-pressure warning).
REVERIE_FILE_TARGET_PCT=0.60
# Target as a fraction of the permanent-memory cap.
REVERIE_MEMORY_TARGET_PCT=0.60
# Only fire if the agent had activity in this window.
REVERIE_ACTIVITY_WINDOW_HOURS=24
# The DM partner the reverie turn runs as.
REVERIE_USER_EMAIL=
# Optional per-agent instruction file (relative to pie/<agent>/identity/).
REVERIE_PROMPT_FILE=REVERIE.md
# Identity files the reverie must NOT edit (user permission only).
REVERIE_PROTECTED_FILES=SOUL.md
# Optional cap on the tool iterations of one reverie turn (0 = use the
# global agent.max_tool_iterations).
REVERIE_MAX_TOOL_ITERATIONS=0

# --- Agent loop invariants ----------------------------------------------------
# Maximum tool iterations in one turn.
MAX_TOOL_ITERATIONS=25
# Maximum memory searches in one turn.
MAX_SEARCHES_PER_TURN=15
# Maximum pins in one turn.
MAX_PINS_PER_TURN=10
# Maximum unpins in one turn.
MAX_UNPINS_PER_TURN=10

# --- Rate limiting -------------------------------------------------------------
# Default rate limit per client.
RATE_LIMIT_DEFAULT=100/minute
# Rate limit for the chat endpoints.
RATE_LIMIT_CHAT=30/minute
# Rate limit for the memory endpoints.
RATE_LIMIT_MEMORY=60/minute

# --- Security headers ----------------------------------------------------------
# max-age of the Strict-Transport-Security header (seconds).
SECURITY_HSTS_MAX_AGE=15552000
# Shared secret for internal (server-to-server) calls. Generate one, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HARNESS_INTERNAL_TOKEN=replace-me-with-a-random-token-32-chars-min

# -----------------------------------------------------------------------------
# Per-pie secrets (harness-wide fallback, NOT required for pie-specific keys)
# -----------------------------------------------------------------------------
# The harness-wide .env is for shared infrastructure secrets only
# (LLM keys, DB URLs, TLS, rate limits). Secrets that should be scoped to a
# single pie (e.g. a single agent's email credentials) live in that pie's
# own .env file at:
#
#     pie/<pie_name>/.env
#
# Each pie's .env is loaded by its own env_loader.py with override=False, so
# values already in the process environment (from the harness .env at
# startup) still win. See SECURITY.md for the full rules and mode
# requirements.
